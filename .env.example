# --- Legacy bot/sqlite ---
TG_TOKEN=
DB_PATH=./db/olymp.db
# Каталог на хосте с olymp.db для docker-compose.bot.yml (сервер: /var/opt/dmk)
BOT_DB_HOST_DIR=/var/opt/dmk
API_KEY=
# Ключ для POST /api/v1/salary/integration (заголовок X-Salary-Api-Key). Если пусто — используется API_KEY.
SALARY_INTEGRATION_API_KEY=
ADMIN_PASSWORD=

# --- Docker images ---
API_IMAGE=recod0/dmk-logistic-api:latest
WEB_IMAGE=recod0/dmk-logistic-web:latest
# Только Telegram-бот: docker compose -f docker-compose.bot.yml up -d
BOT_IMAGE=recod0/dmk-logistic-bot:latest

# --- Uploads (фото документов точек, вложения чатов) ---
# Путь внутри контейнера api; должен совпадать с mount в docker-compose.
MOBILE_UPLOAD_ROOT=/data/mobile_uploads

# --- Postgres / new mobile stack ---
POSTGRES_DB=dmk_logistic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DSN=postgresql+psycopg://postgres:postgres@db:5432/dmk_logistic
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/dmk_logistic

# --- JWT auth ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Web Push (PWA notifications) ---
# VAPID_PUBLIC_KEY: base64url-encoded uncompressed EC public key (P-256), no padding.
# VAPID_PRIVATE_KEY: can be either:
# - base64url-encoded PKCS8 DER (single-line; recommended), or
# - PEM (-----BEGIN PRIVATE KEY----- ...)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@localhost

# --- Optional bootstrap user for local env ---
BOOTSTRAP_DEMO_USER=1
DEMO_LOGIN=driver
DEMO_PASSWORD=driver123
DEMO_ROLE=driver

# --- Web/PWA ---
VITE_API_BASE_URL=/api

# --- Wialon Remote API (бот + mobile_api): только две переменные ---
# WIALON_TOKEN=
# WIALON_BASE_URL=http://w1.wialon.justgps.ru
# Запросы: {WIALON_BASE_URL}/wialon/ajax.html
# Если хост редиректит на monitor.* (HTML), у провайдера запросите прямой URL JSON API без такого редиректа.
# Диагностика в запущенном API: в логах при старте строка "Wialon at startup:"; с JWT —
#   GET {API}/v1/mobile/debug/wialon  и  GET ...?probe=1  (один тестовый token/login)

